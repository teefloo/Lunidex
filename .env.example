# Copy this file to .env.local and fill in the values.

# Enables the in-app Agentation dev overlay (development only).
NEXT_PUBLIC_ENABLE_AGENTATION=false

# Google Search Console verification meta tag (optional).
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# --- Supabase (authentication + cloud sync) ---------------------------------
# From the Supabase Dashboard → Project Settings → Data API / API Keys.
# Only the public anon key belongs here; row access is enforced by RLS.
# When these are empty the app runs fully local-first (IndexedDB), no account UI.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for the consented, aggregated product-measurement endpoint.
# Never expose this value in NEXT_PUBLIC_* variables or client-side code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Neon (application database target; server-only) ------------------------
# Used by migration scripts and, after cutover, by server-side code.
# Use an unpooled connection string for pg_dump/pg_restore. Never expose this
# value through NEXT_PUBLIC_* or EXPO_PUBLIC_* variables.
NEON_DATABASE_URL=

# Local-only source connection string for migration scripts. Do not commit it
# and do not add it to Vercel or mobile configuration.
SUPABASE_DB_URL=
