# Copy this file to .env.local and fill in the values.

# Enables the in-app Agentation dev overlay (development only).
NEXT_PUBLIC_ENABLE_AGENTATION=false

# Google Search Console verification meta tag (optional).
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# --- Neon (database, authentication and cloud sync) -------------------------
# Neon Auth is exposed through the local /api/auth proxy on the web app.
# The URL is public; the server-only values below must never be exposed to the
# browser or committed.
NEXT_PUBLIC_NEON_AUTH_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=
# Copy the exact iss/aud values from the Neon Auth JWT configuration. When set,
# bearer tokens with a different issuer or audience are rejected.
NEON_AUTH_JWT_ISSUER=
NEON_AUTH_JWT_AUDIENCE=

# The Neon integration provides DATABASE_URL automatically on Vercel.
# Use an unpooled connection string for pg_dump/pg_restore. Never expose this
# value through NEXT_PUBLIC_* or EXPO_PUBLIC_* variables.
NEON_DATABASE_URL=

# --- Native application ------------------------------------------------------
# The mobile app calls the same Neon Auth branch and the deployed Neon-backed
# application API. These are public endpoints; authentication tokens are stored
# by the mobile platform's secure-storage adapter.
EXPO_PUBLIC_NEON_AUTH_URL=
EXPO_PUBLIC_APP_URL=https://lunidex.app

# Local-only source connection string for the migration scripts. Do not commit
# it and do not add it to Vercel or mobile runtime configuration.
SUPABASE_DB_URL=

# --- Contact email (server-only) --------------------------------------------
# Install/connect Resend and set RESEND_API_KEY in Vercel. Never use a
# NEXT_PUBLIC_* variable for the API key.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Use onboarding@resend.dev until lunidex.app is verified in Resend.
CONTACT_FROM_EMAIL="Lunidex <onboarding@resend.dev>"
