# Copy this file to .env.local and fill in the values.

# Enables the in-app Agentation dev overlay (development only).
NEXT_PUBLIC_ENABLE_AGENTATION=false

# --- PostHog product analytics ----------------------------------------------
# The project token starts with phc_ and is public by design. Keep the
# integration disabled until a token is configured and the PostHog project is
# ready to receive consented product measurement.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Explicit kill switch. Set per environment; use separate PostHog projects for
# production and non-production when preview/local data must not mix.
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_ENVIRONMENT=development
# Optional release identifier shown on events and exceptions. Docker builds set
# it to the full Git SHA automatically.
NEXT_PUBLIC_APP_RELEASE=
# Replay is consent-gated and sampled; defaults are 10% production, 25% preview,
# and 100% development when explicitly enabled.
NEXT_PUBLIC_POSTHOG_REPLAY_SAMPLE_RATE=

# --- Sentry observability ---------------------------------------------------
# The DSN is public by design and is safe to expose in the browser bundle.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
# Public VAPID key used by browser push subscriptions, when push is configured.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server/build-only values. SENTRY_AUTH_TOKEN is used by CI to upload source
# maps and associate production builds with Sentry releases.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_ORG=teeflo
SENTRY_PROJECT=lunidex
SENTRY_AUTH_TOKEN=

# Google Search Console verification meta tag (optional).
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# --- Supabase (runtime) ------------------------------------------------------
# Public Supabase Auth configuration. The publishable key is designed for the
# browser; database credentials and the server admin key below are not.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set to false for owner-only deployment windows. GitHub production builds default to false.
NEXT_PUBLIC_AUTH_REGISTRATION_ENABLED=false

# Long-running OVH Node runtime: use Supabase's shared session pooler URL over
# verified TLS (port 5432). Keep this pool separate from migration access.
SUPABASE_DATABASE_URL=
SUPABASE_ALLOWED_USER_ID=
SUPABASE_DB_POOL_MAX=5
# Preferred Supabase server/admin API key (`sb_secret_...`). Server-only;
# required for account deletion and the one-time Auth identity import.
SUPABASE_SECRET_KEY=
# Temporary legacy fallback only. Use SUPABASE_SECRET_KEY when both are set.
SUPABASE_SERVICE_ROLE_KEY=

# --- One-time Neon -> Supabase migration tooling -----------------------------
# Read-only Neon source URL. Use a source role limited to SELECT on the current
# app/public/analytics schema and the reviewed Neon Auth identity columns.
NEON_SOURCE_DATABASE_URL=
# Direct Supabase database URL for schema migration, import and verification.
# Do not use the OVH runtime pool URL here. The script checks its project ref.
SUPABASE_MIGRATION_DATABASE_URL=
# Must match the `ref` in the Supabase API URL and database connection.
SUPABASE_PROJECT_REF=
# Set only for an explicitly frozen migration window before Auth/data import.
LUNIDEX_MIGRATION_WRITE_FREEZE=
# Private local output for source data and identity export; ignored by git.
LUNIDEX_MIGRATION_EXPORT_DIR=.migration/neon-to-supabase

# --- Contact email (server-only) --------------------------------------------
# Configure Resend secrets in the protected OVH production environment. Never
# use a NEXT_PUBLIC_* variable for the API key.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Use onboarding@resend.dev until lunidex.app is verified in Resend.
CONTACT_FROM_EMAIL="Lunidex <onboarding@resend.dev>"

# --- Self-hosted scheduled API routes and Web Push -------------------------
# VPS-only names keep web runtime values separate from Supabase Edge Function
# secrets. Never expose these server values to the browser.
LUNIDEX_CRON_SECRET=
LUNIDEX_VAPID_PRIVATE_KEY=
LUNIDEX_VAPID_SUBJECT=mailto:contact@lunidex.app
