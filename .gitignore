# =============================================================================
# PrimeDex — .gitignore (Monorepo Next.js 16 + Expo)
# https://git-scm.com/docs/gitignore
# =============================================================================


# =============================================================================
# 1. Dependencies
# =============================================================================
node_modules/
.pnp
.pnp.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# npm — note: package-lock.json IS committed for reproducible installs
npm-shrinkwrap.json
pnpm-lock.yaml
yarn.lock
.yarnrc


# =============================================================================
# 2. Builds / Output
# =============================================================================

# Next.js
.next/
out/

# Production builds
build/
dist/
*.tsbuildinfo

# Expo / React Native
expo-build/
.expo/
.expo-shared/
*.apk
*.aab
*.ipa

# Metro bundler
metro-cache/

# iOS / Xcode
ios/build/
ios/Pods/
ios/DerivedData/
ios/*.xcworkspace/xcuserdata
ios/*.xcworkspace/xcshareddata
ios/*.pbxuser
ios/*.mode1v3
ios/*.mode2v3
ios/*.perspectivev3
ios/*.xcuserstate
ios/*.xccheckout
ios/*.moved-aside
ios/*.hmap
ios/*.ipa
ios/*.dSYM.zip
ios/*.dSYM

# Android / Gradle
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/*.iml
android/.idea/
android/captures/
android/hs_err_pid*
android/app/src/main/assets/index.android.bundle


# =============================================================================
# 3. Testing & QA
# =============================================================================
coverage/
/playwright-report/
/test-results/
/.playwright-cli/
.nyc_output/
*.lcov
*.coverage

# Playwright / Puppeteer traces & screenshots
playwright/.cache/
trace.zip
screenshots/
*.trace


# =============================================================================
# 4. Environment & Secrets
# =============================================================================
.env
.env.*
!.env.example
!.env.template
.env.local
.env.development
.env.test
.env.production
.env.staging

# Secret keys, certs, PEM, p12
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
*.der
*.jks
*.keystore

# Supabase CLI local project metadata
supabase/.temp/

# Local database exports and migration artifacts
.neon-migration/

tsconfig.tsbuildinfo
# =============================================================================
# 5. Logs & Debug
# =============================================================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.log.*
logs/

debug.log
error.log


# =============================================================================
