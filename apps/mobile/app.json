{
  "expo": {
    "name": "PrimeDex",
    "slug": "primedex",
    "scheme": "primedex",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#0b1020",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.primedex.app"
    },
    "android": {
      "package": "com.primedex.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-localization"],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    }
  }
}
